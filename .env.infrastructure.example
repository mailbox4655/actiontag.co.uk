# Copy to .env.infrastructure.local and replace every marked value.
# The local file is Git-ignored and must remain on the operator workstation.
HETZNER_SSH_HOST=204.168.193.41
HETZNER_SSH_USER=root
HETZNER_SSH_PORT=22
HETZNER_SSH_KEY_PATH=C:\\Users\\YOUR_USER\\.ssh\\id_ed25519
HETZNER_SSH_KNOWN_HOSTS_PATH=C:\\Users\\YOUR_USER\\.ssh\\known_hosts

# Zone-limited token: Zone Read + DNS Read only.
CLOUDFLARE_API_TOKEN=REPLACE_ME
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
CLOUDFLARE_ZONE_NAME=actiontag.co.uk
CLOUDFLARE_DEPLOYMENT_HOSTNAME=actiontag.co.uk
CLOUDFLARE_EXPECTED_ZONE_STATUS=pending
