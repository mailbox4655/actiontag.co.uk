{
  "name": @@PROJECT_SLUG_JSON@@,
  "version": "0.1.0",
  "private": true,
  "description": "Designer-ready web application generated by GPT Design Bridge",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch --import tsx server/src/index.ts",
    "check:runtime": "node scripts/runtime-check.mjs",
    "check:policy": "node scripts/policy-check.mjs",
    "check:deployment": "node scripts/deployment-contract-check.mjs",
    "check:types": "tsc -p tsconfig.check.json --noEmit",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "check": "npm run check:runtime && npm run check:policy && npm run check:deployment && npm run check:types && npm test",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run check && node scripts/prepare-build-output.mjs && npm run build:web && npm run build:server",
    "start": "node dist/server/server/src/index.js",
    "migrate": "node dist/server/server/src/migrate.js",
    "database:proof": "node dist/server/server/src/database-proof.js",
    "deploy:doctor": "bash deploy/native/doctor.sh",
    "backup": "bash deploy/native/backup.sh",
    "restore:proof": "bash deploy/native/restore-proof.sh",
    "design:seed": "node scripts/create-designer-seed.mjs",
    "design:prepare": "python .gpt-design-bridge/tools/gpt_design_bridge.py stage-prepare"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "hono": "4.12.34",
    "lucide-react": "0.525.0",
    "postmark": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.7",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
