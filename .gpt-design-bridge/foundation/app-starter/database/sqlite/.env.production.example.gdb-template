APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=@@APPLICATION_PORT@@
APP_ORIGIN=https://@@DEPLOYMENT_HOSTNAME@@
DATABASE_KIND=sqlite
SQLITE_PATH=/var/lib/@@PROJECT_SLUG@@/app.sqlite3
MAIL_MODE=postmark
POSTMARK_SERVER_TOKEN=SPECIMEN_REQUIRED_POSTMARK_SERVER_TOKEN
POSTMARK_FROM=SPECIMEN_REQUIRED_APPROVED_SENDER@example.invalid
POSTMARK_MESSAGE_STREAM=SPECIMEN_REQUIRED_PRODUCTION_STREAM
