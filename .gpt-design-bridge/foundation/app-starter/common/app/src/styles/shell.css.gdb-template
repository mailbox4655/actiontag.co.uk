* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  background: var(--paper);
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(circle at 15% -10%, rgb(29 102 84 / 12%), transparent 38rem),
    var(--paper);
  font-family: var(--font-sans);
  text-rendering: optimizeLegibility;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled,
input:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: none;
  box-shadow: var(--focus);
}

.app-shell {
  min-height: 100vh;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 4.5rem;
  padding: 0.8rem clamp(1rem, 5vw, 4.5rem);
  border-bottom: 1px solid rgb(184 178 165 / 65%);
  background: rgb(255 253 248 / 82%);
  backdrop-filter: blur(14px);
}

.brand {
  display: inline-flex;
  gap: 0.7rem;
  align-items: center;
  border-radius: var(--radius-small);
  color: var(--ink-strong);
  font-weight: 760;
  letter-spacing: -0.02em;
  text-decoration: none;
}

.brand-mark {
  display: inline-grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  border-radius: 0.7rem;
  color: white;
  background: var(--brand);
}

.status-chip {
  display: inline-flex;
  gap: 0.5rem;
  align-items: center;
  padding: 0.48rem 0.75rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink-muted);
  background: var(--surface);
  font-size: 0.78rem;
  font-weight: 680;
}

.status-dot {
  width: 0.45rem;
  height: 0.45rem;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 3px var(--brand-soft);
}

.status-chip[data-status="failed"] .status-dot {
  background: var(--danger);
  box-shadow: 0 0 0 3px var(--danger-soft);
}

.workspace {
  width: min(100% - 2rem, 72rem);
  margin: 0 auto;
  padding: clamp(3rem, 8vw, 7rem) 0 5rem;
}

@media (max-width: 640px) {
  .app-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }

  .status-chip {
    align-self: stretch;
    justify-content: center;
  }
}
