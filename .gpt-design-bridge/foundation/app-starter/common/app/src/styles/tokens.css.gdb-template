:root {
  color-scheme: light;
  --ink-strong: #17201d;
  --ink: #35413d;
  --ink-muted: #6c7773;
  --paper: #f4f1e9;
  --surface: #fffdf8;
  --surface-raised: #ffffff;
  --line: #dcd8cd;
  --line-strong: #b8b2a5;
  --brand: #1d6654;
  --brand-strong: #124a3d;
  --brand-soft: #dcece6;
  --danger: #a6382f;
  --danger-soft: #fff0ed;
  --shadow: 0 22px 55px rgb(38 48 43 / 10%);
  --radius-small: 0.65rem;
  --radius-medium: 1rem;
  --radius-large: 1.4rem;
  --focus: 0 0 0 3px rgb(29 102 84 / 24%);
  --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}
