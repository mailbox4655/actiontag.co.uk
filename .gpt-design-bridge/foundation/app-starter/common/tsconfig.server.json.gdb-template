{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": false,
    "outDir": "dist/server",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests"
  ]
}
