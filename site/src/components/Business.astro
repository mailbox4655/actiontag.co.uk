---
interface Props { t: Record<string, any> }
const { t } = Astro.props;
---

<section class="section business" id="business">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">{t.business.title}</h2>
      <p class="section-sub">{t.business.subtitle}</p>
    </div>

    <div class="options">
      {t.business.options.map((o: any, i: number) => (
        <article class="card option">
          <span class="option-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </article>
      ))}
    </div>

    <p class="business-footer">{t.business.footer}</p>
    <a class="btn btn-primary" href="#contact">{t.business.cta}</a>
  </div>
</section>

<style>
  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.2rem;
  }
  .option { padding: 2rem 1.8rem; position: relative; }
  .option-num {
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1px var(--line);
    line-height: 1;
    display: block;
  }
  .option h3 {
    font-size: 1.6rem;
    text-transform: uppercase;
    margin-block: 0.9rem 0.6rem;
    color: var(--accent-hot);
  }
  .option p { color: var(--text-muted); font-size: 0.97rem; }
  .business-footer {
    margin-block: 2rem 1.6rem;
    max-width: 44rem;
    color: var(--text-muted);
  }
</style>
