---
import dialcodes from '../data/dialcodes.json';

interface Props { t: Record<string, any>; lang: string }
const { t, lang } = Astro.props;

const waIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>';
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="info-wrap">
      <div class="contact-info">
        <h2 class="section-title">{t.contact.title}</h2>
        <p class="section-sub">{t.contact.subtitle}</p>

        <dl class="contact-details">
        <div>
          <dt>{t.contact.phone_label}</dt>
          <dd class="phone-line">
            <a href="https://wa.me/447889444393" target="_blank" rel="noopener">+44 (0) 7889 444393</a>
            <a class="wa-link" href="https://wa.me/447889444393" target="_blank" rel="noopener"
               aria-label={t.contact.whatsapp} title={t.contact.whatsapp} set:html={waIcon} />
          </dd>
        </div>
        <div>
          <dt>{t.contact.email_label}</dt>
          <dd><a href="mailto:sales@actiontag.co.uk">sales@actiontag.co.uk</a></dd>
        </div>
        <div>
          <dt>{t.contact.address_label}</dt>
          <dd class="address">
            {t.contact.address.map((line: string) => <span>{line}</span>)}
          </dd>
        </div>
      </dl>
      </div>

      <div class="akgirl-col" aria-hidden="true">
        <img
          data-akgirl
          src="/assets/video/akgirl-poster.png"
          data-anim="/assets/video/akgirl.webp"
          alt=""
          width="566"
          height="739"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <form class="card contact-form" method="post" action="/api/contact" data-contact-form data-lang={lang}>
      <label>
        <span>{t.contact.name}</span>
        <input type="text" name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label>
        <span>{t.contact.email}</span>
        <input type="email" name="email" required maxlength="200" autocomplete="email" />
      </label>
      <div class="field">
        <span class="field-label">{t.contact.phone}</span>
        <div class="phone-row" dir="ltr">
          <details class="cc-select" data-cc-select>
            <summary>
              <img data-cc-flag src="/assets/flags/cc/gb.svg" alt="" width="18" height="18" />
              <span data-cc-dial>+44</span>
            </summary>
            <div class="cc-pop">
              <input type="text" class="cc-filter" placeholder={t.contact.search_country} data-cc-filter autocomplete="off" />
              <ul class="cc-list" data-cc-list>
                {dialcodes.map((c: any) => (
                  <li data-name={c.name.toLowerCase()} data-dial={c.dial}>
                    <button type="button" data-cc={c.cc.toLowerCase()} data-dial={c.dial}>
                      <img src={`/assets/flags/cc/${c.cc.toLowerCase()}.svg`} alt="" width="18" height="18" loading="lazy" />
                      <span class="cc-name">{c.name}</span>
                      <em>{c.dial}</em>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          </details>
          <input type="hidden" name="phone_cc" value="+44" data-cc-value />
          <input type="tel" name="phone" maxlength="40" autocomplete="tel-national" />
        </div>
      </div>
      <label>
        <span>{t.contact.message}</span>
        <textarea name="message" rows="5" required maxlength="5000"></textarea>
      </label>
      <!-- honeypot: bots fill it, humans never see it -->
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />

      <button class="btn btn-primary" type="submit" data-submit>{t.contact.send}</button>
      <p class="form-status" data-status role="status" aria-live="polite"
         data-msg-sending={t.contact.sending}
         data-msg-success={t.contact.success}
         data-msg-error={`${t.contact.error} sales@actiontag.co.uk`}></p>
    </form>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  /* text + girl share the left cell; girl's height follows the text column */
  .info-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.78fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: stretch;
  }
  @media (max-width: 980px) {
    .contact-grid { grid-template-columns: 1fr; }
    .info-wrap { grid-template-columns: 1fr; }
    .info-wrap, .contact-form { min-width: 0; }
  }

  .contact-details { margin-block: 2.2rem 0; display: grid; gap: 1.3rem; }
  .contact-details dt {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .contact-details dd { margin: 0.2rem 0 0; font-size: 1.25rem; }
  .contact-details a { text-decoration: none; }
  .contact-details a:hover { color: var(--accent-hot); }

  .phone-line { display: flex; align-items: center; gap: 0.7rem; }
  .wa-link {
    display: inline-flex;
    color: var(--text);
    opacity: 0.85;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .wa-link :global(svg) { width: 22px; height: 22px; }
  .wa-link:hover { opacity: 1; color: #25d366; }

  .address { display: grid; font-size: 1.05rem; line-height: 1.5; }

  /* girl: absolutely fills her cell, whose height is set by the text column —
     top edge at the section title, feet at the bottom of the address */
  .akgirl-col {
    position: relative;
    z-index: 10;
  }
  .akgirl-col::before {
    content: '';
    position: absolute;
    inset-inline: 5%;
    inset-block-end: 0;
    height: 40%;
    background: radial-gradient(ellipse at 50% 100%, var(--accent-dim) 0%, transparent 70%);
  }
  .akgirl-col img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.55));
  }
  @media (max-width: 980px) {
    .akgirl-col { display: flex; justify-content: center; }
    .akgirl-col img { position: static; width: auto; height: auto; max-height: 20rem; }
    .akgirl-col::before { inset-inline: 20%; }
  }

  .contact-form { padding: 2rem; display: grid; gap: 1.1rem; }
  .contact-form > *, .contact-form .field > * { min-width: 0; }
  .contact-form label, .contact-form .field { display: grid; gap: 0.4rem; }
  .contact-form label span, .field-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .contact-form input,
  .contact-form textarea {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text);
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.97rem;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  /* ---- country code selector ---- */
  .phone-row { display: flex; gap: 0.5rem; position: relative; }
  .phone-row input[type='tel'] { flex: 1; min-width: 0; }
  .cc-select { position: static; }
  .cc-select summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    user-select: none;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
    font-size: 0.97rem;
    min-width: 6.2rem;
  }
  .cc-select summary::-webkit-details-marker { display: none; }
  .cc-select summary::after { content: '▾'; font-size: 0.65em; color: var(--text-muted); margin-inline-start: auto; }
  .cc-select[open] summary { border-color: var(--accent); }
  .cc-select summary img { width: 18px; height: 18px; }

  .cc-pop {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 6px);
    z-index: 20;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    padding: 0.5rem;
  }
  .cc-filter {
    width: 100%;
    margin-block-end: 0.4rem;
  }
  .cc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 15rem;
    overflow-y: auto;
  }
  .cc-list button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    background: none;
    border: 0;
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    padding: 0.42rem 0.6rem;
    border-radius: 5px;
    cursor: pointer;
    text-align: start;
  }
  .cc-list button:hover { background: var(--accent-dim); }
  .cc-list img { flex: none; }
  .cc-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cc-list em { font-style: normal; color: var(--text-muted); }

  .hp { position: absolute; inset-inline-start: -9999px; }
  .form-status { min-height: 1.4em; font-size: 0.95rem; color: var(--text-muted); }
  .form-status.ok { color: #6fdc8c; }
  .form-status.err { color: var(--accent-hot); }
</style>

<script>
  // ---- AK girl: static until scrolled into view, come alive after 5s ----
  document.querySelectorAll<HTMLImageElement>('[data-akgirl]').forEach((img) => {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        // preload the animation during the pause so the swap is seamless
        const pre = new Image();
        pre.src = img.dataset.anim!;
        setTimeout(() => { img.src = img.dataset.anim!; }, 5000);
      },
      { threshold: 0.35 }
    );
    io.observe(img);
  });

  // ---- country code selector ----
  document.querySelectorAll<HTMLDetailsElement>('[data-cc-select]').forEach((sel) => {
    const form = sel.closest('form')!;
    const flag = sel.querySelector('[data-cc-flag]') as HTMLImageElement;
    const dialLabel = sel.querySelector('[data-cc-dial]') as HTMLElement;
    const hidden = form.querySelector('[data-cc-value]') as HTMLInputElement;
    const filter = sel.querySelector('[data-cc-filter]') as HTMLInputElement;
    const items = Array.from(sel.querySelectorAll('[data-cc-list] li')) as HTMLElement[];

    sel.addEventListener('toggle', () => {
      if (sel.open) { filter.value = ''; applyFilter(); filter.focus(); }
    });

    function applyFilter() {
      const q = filter.value.trim().toLowerCase();
      items.forEach((li) => {
        const hit = !q || li.dataset.name!.includes(q) || li.dataset.dial!.includes(q);
        li.style.display = hit ? '' : 'none';
      });
    }
    filter.addEventListener('input', applyFilter);

    sel.querySelectorAll('button[data-cc]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const b = btn as HTMLElement;
        flag.src = `/assets/flags/cc/${b.dataset.cc}.svg`;
        dialLabel.textContent = b.dataset.dial!;
        hidden.value = b.dataset.dial!;
        sel.removeAttribute('open');
      });
    });
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('.cc-select[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  // ---- form submit ----
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector('[data-status]') as HTMLElement;
    const btn = form.querySelector('[data-submit]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'form-status';
      status.textContent = status.dataset.msgSending ?? '…';
      btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form) as any),
        });
        if (!res.ok) throw new Error(String(res.status));
        status.classList.add('ok');
        status.textContent = status.dataset.msgSuccess ?? 'OK';
        form.reset();
      } catch {
        status.classList.add('err');
        status.textContent = status.dataset.msgError ?? 'Error';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
