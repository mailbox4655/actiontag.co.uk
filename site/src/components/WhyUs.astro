---
interface Props { t: Record<string, any> }
const { t } = Astro.props;

// Lucide icons (ISC license), inlined so they inherit the accent colour
const lucide: Record<string, string> = {
  trophy:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978"/><path d="M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978"/><path d="M18 9h1.5a1 1 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"/><path d="M6 9H4.5a1 1 0 0 1 0-5H6"/></svg>',
  wrench:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
  handshake:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>',
};

// icon per card; card index 1 shows real flags instead
const cardIcons = ['trophy', null, 'wrench', 'handshake'];
---

<section class="section why">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">{t.why.title}</h2>
    </div>
    <div class="grid">
      {t.why.items.map((item: any, i: number) => (
        <article class="card why-card">
          {cardIcons[i] ? (
            <span class="why-icon" aria-hidden="true" set:html={lucide[cardIcons[i]!]} />
          ) : (
            <span class="why-icon why-flags" aria-hidden="true">
              <img src="/assets/flags/eu.svg" alt="" width="26" height="26" />
              <img src="/assets/flags/en.svg" alt="" width="26" height="26" />
              <img src="/assets/flags/ie.svg" alt="" width="26" height="26" />
            </span>
          )}
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.2rem;
  }
  .why-card { padding: 1.8rem; }
  .why-icon { display: inline-flex; gap: 0.4rem; color: var(--accent); }
  .why-icon :global(svg) { width: 28px; height: 28px; }
  .why-flags img { width: 26px; height: 26px; }
  .why-card h3 {
    font-size: 1.45rem;
    text-transform: uppercase;
    margin-block: 0.8rem 0.6rem;
  }
  .why-card p { color: var(--text-muted); font-size: 0.97rem; }
</style>
