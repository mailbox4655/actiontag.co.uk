---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import WhyUs from '../../components/WhyUs.astro';
import DeviceCarousel from '../../components/DeviceCarousel.astro';
import PropsGrid from '../../components/PropsGrid.astro';
import MilSim from '../../components/MilSim.astro';
import Business from '../../components/Business.astro';
import ProductFamily from '../../components/ProductFamily.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { localeCodes, getCatalog } from '../../i18n/locales';

export function getStaticPaths() {
  return localeCodes.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getCatalog(lang!);
---

<Base lang={lang!} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang!} t={t} />
  <main>
    <Hero t={t} />
    <WhyUs t={t} />
    <DeviceCarousel t={t} />
    <PropsGrid t={t} />
    <MilSim t={t} />
    <Business t={t} />
    <ProductFamily t={t} />
    <Contact t={t} lang={lang!} />
  </main>
  <Footer t={t} />
</Base>
